# Copy to .env and fill in your real values.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Verify current model slugs at https://openrouter.ai/models — the
# primary/backup models must support tool calling for the Maker.
PRIMARY_MODEL=anthropic/claude-sonnet-4.6
BACKUP_MODEL=openai/gpt-4o-mini
CHECKER_MODEL=openai/gpt-4o-mini

MAX_REVISION_ROUNDS=2
MAX_ITERATIONS=6
REQUEST_TIMEOUT_SECONDS=20
TOOL_TIMEOUT_SECONDS=8
OVERALL_REQUEST_TIMEOUT_SECONDS=60

REQUEST_TOKEN_BUDGET=8000

CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_SECONDS=30
